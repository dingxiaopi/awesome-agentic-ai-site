---
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionGrid from '../components/CollectionGrid.astro';
import RouteTimeline from '../components/RouteTimeline.astro';
import { getHomeData } from '../lib/content';
import { createSectionLanguageLinks, getCollectionLabel, type SiteLang } from '../lib/i18n';

interface Props {
  lang?: SiteLang;
}

const { lang = 'zh-cn' } = Astro.props;
const { stages, tracks, branches, resources, featuredStages, trackSteps, branchSteps } = await getHomeData(lang);
const labels = {
  'zh-cn': {
    eyebrow: 'AI Agent 学习地图',
    title: '系统学习 Agentic AI',
    intro: '从基础概念到动手搭建 Agent，按阶段、目标和身份组织好的中文学习路线。不知道从哪开始，就从第一阶段读起。',
    primaryCta: '从第一阶段开始',
    secondaryCta: '查看路线图',
    pathsTitle: '三种学习方式',
    pathsDesc: '先按阶段打基础，再按目标或身份挑选适合自己的路线。',
    stagePath: '按阶段学习',
    stagePathDesc: '从基础概念到真实落地，一步步建立 Agentic AI 知识体系。',
    trackPath: '按目标学习',
    trackPathDesc: '围绕真实任务与应用结果，选择更贴近实践的路线。',
    branchPath: '按身份学习',
    branchPathDesc: '开发者、研究者、教师、知识工作者，各有对应内容。',
    featuredTitle: '推荐起步',
    featuredDesc: '先读这几篇，快速建立整体认知。',
    allStages: '全部阶段',
    trackTitle: '目标路线',
    branchTitle: '人群路线'
  },
  'zh-tw': {
    eyebrow: 'AI Agent 學習地圖',
    title: '系統學習 Agentic AI',
    intro: '從基礎概念到動手搭建 Agent，按階段、目標和身份整理好的中文學習路線。不知道從哪開始，就從第一階段讀起。',
    primaryCta: '從第一階段開始',
    secondaryCta: '查看路線圖',
    pathsTitle: '三種學習方式',
    pathsDesc: '先按階段打基礎，再依目標或身份挑選適合自己的路線。',
    stagePath: '按階段學習',
    stagePathDesc: '從基礎概念到真實落地，一步步建立 Agentic AI 知識體系。',
    trackPath: '按目標學習',
    trackPathDesc: '圍繞真實任務與應用結果，選擇更貼近實作的路線。',
    branchPath: '按身份學習',
    branchPathDesc: '開發者、研究者、教師、知識工作者，各有對應內容。',
    featuredTitle: '推薦起步',
    featuredDesc: '先讀這幾篇，快速建立整體認知。',
    allStages: '全部階段',
    trackTitle: '目標路線',
    branchTitle: '族群路線'
  },
  en: {
    eyebrow: 'AI Agent learning map',
    title: 'Learn Agentic AI, step by step',
    intro: 'From core concepts to building your own agents, organized by stage, goal, and role. Not sure where to start? Begin with Stage 0.',
    primaryCta: 'Start with Stage 0',
    secondaryCta: 'View roadmap',
    pathsTitle: 'Three ways to learn',
    pathsDesc: 'Build foundations by stage, then pick a route by goal or role.',
    stagePath: 'Learn by stage',
    stagePathDesc: 'Move from core concepts to real implementation step by step.',
    trackPath: 'Learn by goal',
    trackPathDesc: 'Routes shaped around practical outcomes and real tasks.',
    branchPath: 'Learn by role',
    branchPathDesc: 'Content for developers, researchers, teachers, and knowledge workers.',
    featuredTitle: 'Start here',
    featuredDesc: 'Read these first to build a solid mental model.',
    allStages: 'All stages',
    trackTitle: 'Goal-based paths',
    branchTitle: 'Audience-based paths'
  }
}[lang];

const currentPath = '/';
const prefix = lang === 'zh-cn' ? '' : `/${lang}`;
const stats = [
  { value: stages.length, label: getCollectionLabel('stages', lang) },
  { value: tracks.length, label: getCollectionLabel('tracks', lang) },
  { value: branches.length, label: getCollectionLabel('branches', lang) },
  { value: resources.length, label: getCollectionLabel('resources', lang) }
];
const paths = [
  { title: labels.stagePath, description: labels.stagePathDesc, href: `${prefix}/stages/`, meta: '01' },
  { title: labels.trackPath, description: labels.trackPathDesc, href: `${prefix}/tracks/`, meta: '02' },
  { title: labels.branchPath, description: labels.branchPathDesc, href: `${prefix}/branches/`, meta: '03' }
];
const firstStageHref = featuredStages[0]?.href ?? `${prefix}/stages/`;
---
<BaseLayout
  title="Awesome Agentic AI 学习站"
  description="基于 awesome-agentic-ai-zh 构建的多语言 Agentic AI 学习地图。"
  lang={lang}
  currentPath={currentPath}
  languageLinks={createSectionLanguageLinks(currentPath)}
>
  <section class="home-hero">
    <p class="eyebrow">{labels.eyebrow}</p>
    <h1>{labels.title}</h1>
    <p class="hero-lead">{labels.intro}</p>
    <div class="button-row">
      <a class="button primary" href={firstStageHref}>{labels.primaryCta} →</a>
      <a class="button" href={`${prefix}/roadmap/`}>{labels.secondaryCta}</a>
    </div>
    <dl class="home-stats">
      {stats.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>{labels.pathsTitle}</h2>
        <p>{labels.pathsDesc}</p>
      </div>
    </div>
    <CollectionGrid items={paths} variant="feature" />
  </section>

  <section class="section">
    <div class="section-head">
      <div>
        <h2>{labels.featuredTitle}</h2>
        <p>{labels.featuredDesc}</p>
      </div>
      <a class="section-link" href={`${prefix}/stages/`}>{labels.allStages} →</a>
    </div>
    <CollectionGrid items={featuredStages} variant="feature" />
  </section>

  <section class="section grid cols-2 home-routes">
    <RouteTimeline title={labels.trackTitle} steps={trackSteps} />
    <RouteTimeline title={labels.branchTitle} steps={branchSteps} />
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding: 2.5rem 0 1rem;
    max-width: 52rem;
  }
  .home-hero h1 { font-size: clamp(2.3rem, 5vw, 3.6rem); }
  .home-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.75rem;
    margin: 2.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .home-stats div { display: flex; flex-direction: column-reverse; }
  .home-stats dt { color: var(--muted); font-size: 0.88rem; }
  .home-stats dd { margin: 0; font-size: 1.75rem; font-weight: 650; line-height: 1.2; }
  .home-routes { gap: 3rem; }
  @media (max-width: 960px) {
    .home-hero { padding-top: 1rem; }
    .home-routes { gap: 1rem; }
  }
</style>
