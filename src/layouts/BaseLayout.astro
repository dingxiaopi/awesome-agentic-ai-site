---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import manifest from '../data/sync-manifest.json';
import { LANG_CONFIG, buildLangPath, createSectionLanguageLinks, type SiteLang } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: SiteLang;
  currentPath?: string;
  languageLinks?: Array<{ lang: SiteLang; label: string; href: string }>;
  image?: string;
  noindex?: boolean;
}
const SITE_URL = 'https://awesome-agentic-ai-site.vercel.app';
const DEFAULT_SOCIAL_IMAGE = '/favicon.svg';
const {
  title = 'Awesome Agentic AI 学习站',
  description = '基于 awesome-agentic-ai-zh 构建的 Astro 学习地图网站。',
  lang = 'zh-cn',
  currentPath = '/',
  languageLinks = createSectionLanguageLinks(currentPath),
  image = DEFAULT_SOCIAL_IMAGE,
  noindex = false
} = Astro.props;

const canonicalUrl = new URL(buildLangPath(lang, currentPath), SITE_URL).toString();
const socialImageUrl = new URL(image, SITE_URL).toString();
const alternateLinks = languageLinks.map((link) => ({
  ...link,
  absoluteHref: new URL(link.href, SITE_URL).toString(),
  htmlLang: LANG_CONFIG[link.lang].htmlLang
}));
const xDefaultHref = new URL(buildLangPath('zh-cn', currentPath), SITE_URL).toString();

const navLabels = {
  'zh-cn': { roadmap: '路线图', stages: '学习阶段', tracks: '目标路线', branches: '人群路线', resources: '资源', search: '搜索', site: '学习站', footer: '把 awesome-agentic-ai-zh 整理成可以照着走的多语言学习网站。', synced: '内容更新于', updates: '同步记录', siteRepo: '网站仓库', contentRepo: '内容仓库' },
  'zh-tw': { roadmap: '路線圖', stages: '學習階段', tracks: '目標路線', branches: '族群路線', resources: '資源', search: '搜尋', site: '學習站', footer: '把 awesome-agentic-ai-zh 整理成可以照著走的多語言學習網站。', synced: '內容更新於', updates: '同步紀錄', siteRepo: '網站倉庫', contentRepo: '內容倉庫' },
  en: { roadmap: 'Roadmap', stages: 'Stages', tracks: 'Tracks', branches: 'Audiences', resources: 'Resources', search: 'Search', site: 'Learning Hub', footer: 'A multilingual learning site built from awesome-agentic-ai-zh.', synced: 'Content updated', updates: 'Sync log', siteRepo: 'Site repo', contentRepo: 'Content repo' }
}[lang];

const navItems = (['roadmap', 'stages', 'tracks', 'branches', 'resources', 'search'] as const)
  .map((key) => ({ label: navLabels[key], path: `/${key}/`, href: buildLangPath(lang, `/${key}/`) }));
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path);
const syncedDate = manifest.syncedAt === 'pending-sync' ? null : new Date(manifest.syncedAt).toLocaleDateString(LANG_CONFIG[lang].htmlLang);
---
<!doctype html>
<html lang={LANG_CONFIG[lang].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((link) => <link rel="alternate" hreflang={link.htmlLang} href={link.absoluteHref} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome Agentic AI 学习站" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={LANG_CONFIG[lang].htmlLang} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={buildLangPath(lang, '/')}>
          <span class="brand-mark" aria-hidden="true">A</span>
          <span class="brand-text">Awesome Agentic AI <small>{navLabels.site}</small></span>
        </a>

        <div class="header-right">
          <nav class="nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a class:list={["nav-link", isActive(item.path) && 'active']} href={item.href}>{item.label}</a>
            ))}
          </nav>
          <LanguageSwitcher currentLang={lang} links={languageLinks} />
        </div>
      </div>
    </header>

    <main class="shell site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <p class="footer-title">Awesome Agentic AI {navLabels.site}</p>
          <p class="footer-copy">{navLabels.footer}</p>
          {syncedDate && <p class="footer-copy small">{navLabels.synced} {syncedDate}</p>}
        </div>
        <div class="footer-links">
          <a href={buildLangPath(lang, '/updates/')}>{navLabels.updates}</a>
          <a href="https://github.com/dingxiaopi/awesome-agentic-ai-site" target="_blank" rel="noreferrer">{navLabels.siteRepo}</a>
          <a href="https://github.com/WenyuChiou/awesome-agentic-ai-zh" target="_blank" rel="noreferrer">{navLabels.contentRepo}</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f6f3;
    --surface: #ffffff;
    --surface-2: #f0eee9;
    --line: #e3e0d9;
    --line-strong: #cfcac0;
    --text: #1b1c1f;
    --text-soft: #3b3e45;
    --muted: #6e717a;
    --brand: #3150d4;
    --brand-strong: #2640b0;
    --brand-soft: rgba(49, 80, 212, 0.08);
    --code-bg: #16181d;
    --max: 1180px;
    --radius-lg: 14px;
    --radius-md: 10px;
    --header-h: 64px;
    --font-sans: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Noto Sans SC', 'Segoe UI', system-ui, sans-serif;
    --font-mono: 'SF Mono', ui-monospace, Menlo, Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #131417;
      --surface: #1a1b1f;
      --surface-2: #222328;
      --line: #2c2e34;
      --line-strong: #3b3d44;
      --text: #ecedef;
      --text-soft: #c8cad0;
      --muted: #91949d;
      --brand: #8da1ff;
      --brand-strong: #a8b7ff;
      --brand-soft: rgba(141, 161, 255, 0.12);
      --code-bg: #0e0f12;
    }
  }

  * { box-sizing: border-box; }
  html {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }
  body { margin: 0; min-height: 100vh; background: var(--bg); }
  a { color: var(--brand); text-decoration: none; }
  img { max-width: 100%; height: auto; }
  strong { color: var(--text); font-weight: 600; }
  ::selection { background: var(--brand-soft); }
  .shell { width: min(var(--max), calc(100% - 2.5rem)); margin: 0 auto; }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 650;
    font-size: 0.98rem;
    white-space: nowrap;
  }
  .brand-mark {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-grid;
    place-items: center;
    border-radius: 7px;
    background: var(--text);
    color: var(--bg);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .brand-text small {
    margin-left: 0.35rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 400;
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .nav-link {
    position: relative;
    padding: 0.45rem 0.7rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 500;
    transition: color 140ms ease, background 140ms ease;
  }
  .nav-link:hover { color: var(--text); background: var(--surface-2); }
  .nav-link.active { color: var(--text); }
  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: calc((var(--header-h) - 2.2rem) / -2);
    height: 2px;
    border-radius: 2px;
    background: var(--brand);
  }

  /* Footer */
  .site-main { padding: 3rem 0 5rem; }
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0 3rem;
    color: var(--muted);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .footer-title { margin: 0 0 0.35rem; color: var(--text); font-weight: 600; }
  .footer-copy { margin: 0; max-width: 40rem; line-height: 1.7; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer-links a { color: var(--muted); font-size: 0.93rem; }
  .footer-links a:hover { color: var(--text); }

  /* Type */
  h1, h2, h3 { line-height: 1.25; letter-spacing: -0.01em; margin: 0; font-weight: 650; color: var(--text); }
  h1 { font-size: clamp(2rem, 4vw, 2.9rem); line-height: 1.15; }
  h2 { font-size: clamp(1.3rem, 1.8vw, 1.6rem); }
  h3 { font-size: 1.05rem; }
  p, li { line-height: 1.75; }
  .small { font-size: 0.9rem; }
  .muted, .section-copy, .section-head p { color: var(--muted); }

  /* Page heads */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }
  .hero-card { padding: 0; }
  .eyebrow, .section-kicker {
    display: inline-block;
    margin: 0 0 0.6rem;
    color: var(--brand);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .hero-lead {
    margin: 0.9rem 0 0;
    max-width: 42rem;
    color: var(--text-soft);
    font-size: 1.08rem;
  }
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 42px;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    color: var(--text);
    background: var(--surface);
    font-weight: 550;
    font-size: 0.95rem;
    transition: background 140ms ease, border-color 140ms ease;
  }
  .button:hover { background: var(--surface-2); }
  .button.primary {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }
  .button.primary:hover { background: var(--brand-strong); border-color: var(--brand-strong); }
  @media (prefers-color-scheme: dark) {
    .button.primary { color: #10131f; }
  }

  /* Surfaces */
  .panel, .card, .surface {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .panel { padding: 1.5rem; }
  .hero-meta-list, .mini-list, .meta-list { display: grid; gap: 0.75rem; }
  .mini-item, .stat, .quick-card, .route-item, .doc-meta-item {
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: var(--radius-md);
  }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
  .stat { padding: 1rem; }
  .stat span { display: block; color: var(--muted); font-size: 0.85rem; }
  .stat strong { display: block; margin-top: 0.2rem; font-size: 1.4rem; font-weight: 650; }

  .section { margin-top: 3.5rem; }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1.25rem;
  }
  .section-head p { margin: 0.4rem 0 0; }
  .section-link { color: var(--brand); font-weight: 500; font-size: 0.95rem; white-space: nowrap; }
  .section-link:hover { color: var(--brand-strong); }

  .grid { display: grid; gap: 1rem; }
  .grid.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  .card {
    padding: 1.25rem;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }
  .card:hover {
    border-color: var(--line-strong);
    box-shadow: 0 6px 20px -12px rgba(20, 22, 30, 0.25);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    font-family: var(--font-mono);
    letter-spacing: 0.01em;
  }

  /* Docs */
  .doc {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }
  .sidebar-panel, .toc {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    max-height: calc(100vh - var(--header-h) - 3rem);
    overflow: auto;
  }
  .sidebar-panel.surface, .toc.surface { background: transparent; border: 0; border-radius: 0; }
  .markdown { min-width: 0; max-width: 52rem; }
  .markdown > :first-child { margin-top: 0; }
  .markdown h1, .markdown h2, .markdown h3, .markdown h4 { scroll-margin-top: calc(var(--header-h) + 1.5rem); }
  .markdown h2 {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.45rem;
  }
  .markdown h3 { margin-top: 1.8rem; margin-bottom: 0.6rem; font-size: 1.15rem; }
  .markdown p, .markdown li { color: var(--text-soft); font-size: 1.02rem; line-height: 1.85; }
  .markdown li + li { margin-top: 0.2rem; }
  .markdown a {
    color: var(--brand);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--brand) 35%, transparent);
    text-underline-offset: 0.2em;
  }
  .markdown a:hover { text-decoration-color: var(--brand); }
  .markdown table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.95rem;
    display: block;
    overflow-x: auto;
  }
  .markdown th, .markdown td {
    border-bottom: 1px solid var(--line);
    padding: 0.7rem 0.8rem;
    text-align: left;
    vertical-align: top;
  }
  .markdown th { color: var(--text); font-weight: 600; border-bottom-color: var(--line-strong); background: var(--surface-2); }
  .markdown td { color: var(--text-soft); }
  .markdown :not(pre) > code {
    background: var(--surface-2);
    border: 1px solid var(--line);
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  .markdown pre {
    padding: 2.6rem 1.1rem 1.1rem;
    overflow: auto;
    border-radius: var(--radius-md);
    background: var(--code-bg) !important;
    font-size: 0.88rem;
    line-height: 1.65;
  }
  .markdown pre code { font-family: var(--font-mono); }
  .markdown pre[data-language='text'],
  .markdown pre[data-language='plaintext'],
  .markdown pre[data-language='markdown'] { white-space: pre-wrap; word-break: break-word; }
  .markdown details {
    margin: 1.25rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .markdown summary {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--text);
  }
  .markdown summary::-webkit-details-marker { display: none; }
  .markdown summary::before {
    content: '';
    flex: 0 0 auto;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-0.15rem) rotate(-45deg);
    transition: transform 140ms ease;
  }
  .markdown details[open] > summary::before { transform: translateY(-0.25rem) rotate(45deg); }
  .markdown summary:hover { color: var(--brand); }
  .markdown details[open] > summary { border-bottom: 1px solid var(--line); }
  .markdown details > :not(summary) { margin-left: 1rem; margin-right: 1rem; }
  .markdown details > pre { margin-left: 0.75rem; margin-right: 0.75rem; }
  .markdown blockquote {
    margin: 1.5rem 0;
    border-left: 2px solid var(--line-strong);
    padding: 0.1rem 0 0.1rem 1.1rem;
  }
  .markdown blockquote p { margin: 0.4rem 0; color: var(--muted); }
  .markdown hr { display: none; }

  .toc-title, .panel-title {
    margin: 0 0 0.8rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .toc ul, .meta ul { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line); }
  .toc li { margin: 0; }
  .toc a {
    display: block;
    margin-left: -1px;
    padding: 0.3rem 0 0.3rem 0.8rem;
    border-left: 1px solid transparent;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .toc a:hover { color: var(--text); border-left-color: var(--line-strong); }
  .toc .depth-3 { padding-left: 1.5rem; }
  .toc .depth-4 { padding-left: 2.1rem; }

  .route-list { display: grid; gap: 0.75rem; }
  .route-item { padding: 1rem 1.1rem; }
  .empty-note { color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 1180px) {
    .doc { grid-template-columns: 220px minmax(0, 1fr); gap: 2.5rem; }
  }
  @media (max-width: 960px) {
    .grid.cols-2, .grid.cols-3, .doc { grid-template-columns: 1fr; }
    .header-inner { flex-wrap: wrap; padding: 0.6rem 0; gap: 0.5rem 1rem; }
    .header-right { display: contents; }
    .brand { flex: 1; }
    .nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; margin-left: -0.7rem; }
    .nav-link { white-space: nowrap; }
    .nav-link.active::after { display: none; }
    .nav-link.active { background: var(--surface-2); }
    .footer-inner { flex-direction: column; }
    .doc .sidebar-panel { display: none; }
    .site-main { padding-top: 2rem; }
  }
  @media (max-width: 640px) {
    .shell { width: calc(100% - 2rem); }
    .brand-text small { display: none; }
    .card, .panel { padding: 1.1rem; }
    .button-row .button { flex: 1 1 auto; }
  }
</style>
