---
import BaseLayout from './BaseLayout.astro';
import { buildLangPath, type CollectionKey, type SiteLang } from '../lib/i18n';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface CollectionNavItem {
  title: string;
  name?: string;
  index?: string;
  href: string;
  active: boolean;
}

interface AdjacentLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  collectionLabel: string;
  collection: CollectionKey;
  sourceUrl: string;
  sourcePath: string;
  syncedAt: string;
  headings?: Heading[];
  lang: SiteLang;
  currentPath: string;
  languageLinks: Array<{ lang: SiteLang; label: string; href: string }>;
  collectionItems: CollectionNavItem[];
  previousLink?: AdjacentLink | null;
  nextLink?: AdjacentLink | null;
  taxonomy?: {
    collectionLabel: string;
    sectionLabel: string;
    orderLabel: string;
    languageLabel: string;
  };
}

const {
  title,
  description,
  collectionLabel,
  collection,
  sourceUrl,
  sourcePath,
  syncedAt,
  headings = [],
  lang,
  currentPath,
  languageLinks,
  collectionItems,
  previousLink = null,
  nextLink = null,
  taxonomy
} = Astro.props;

const ui = {
  'zh-cn': {
    doc: '',
    home: '首页',
    langVersion: '语言版本',
    syncedAt: '更新于',
    sourceRepo: '在 GitHub 查看原文',
    sourcePath: '查看源文件路径',
    prev: '上一页',
    next: '下一页',
    onThisPage: '本页目录',
    emptyToc: '该页面暂时没有可展示的目录标题。',
    backToTop: '返回顶部',
    copy: '复制',
    copied: '已复制',
    failed: '失败',
    link: '复制标题链接'
  },
  'zh-tw': {
    doc: '',
    home: '首頁',
    langVersion: '語言版本',
    syncedAt: '更新於',
    sourceRepo: '在 GitHub 查看原文',
    sourcePath: '查看原始檔案路徑',
    prev: '上一頁',
    next: '下一頁',
    onThisPage: '本頁目錄',
    emptyToc: '此頁暫時沒有可顯示的目錄標題。',
    backToTop: '返回頂部',
    copy: '複製',
    copied: '已複製',
    failed: '失敗',
    link: '複製標題連結'
  },
  en: {
    doc: 'Documentation',
    home: 'Home',
    langVersion: 'Language',
    syncedAt: 'Updated',
    sourceRepo: 'View on GitHub',
    sourcePath: 'View source file path',
    prev: 'Previous',
    next: 'Next',
    onThisPage: 'On this page',
    emptyToc: 'This page does not have navigable headings yet.',
    backToTop: 'Back to top',
    copy: 'Copy',
    copied: 'Copied',
    failed: 'Failed',
    link: 'Copy heading link'
  }
}[lang];

// 目录只列二级标题，并去掉开头的 emoji，保持简洁
const docHeadings = headings
  .filter((item) => item.depth === 2)
  .map((item) => ({ ...item, text: item.text.replace(/^[\p{Extended_Pictographic}\uFE0F\u200D\s]+/u, '') }));
const syncedText = new Date(syncedAt).toLocaleDateString(lang === 'en' ? 'en' : lang === 'zh-tw' ? 'zh-TW' : 'zh-CN');
const collectionHome = buildLangPath(lang, `/${collection}/`);
---
<BaseLayout
  title={`${title} · Awesome Agentic AI 学习站`}
  description={description}
  lang={lang}
  currentPath={currentPath}
  languageLinks={languageLinks}
>
  <div class="reading-progress" data-reading-progress></div>
  <div class="doc">
    <aside class="sidebar-panel">
      <a class="panel-title sidebar-home" href={collectionHome}>{taxonomy?.collectionLabel ?? collectionLabel}</a>
      <nav class="collection-nav" aria-label={`${collectionLabel} navigation`}>
        {collectionItems.map((item) => (
          <div class="nav-group">
            <a class:list={["collection-nav-link", item.active && 'active']} href={item.href} title={item.title} aria-current={item.active ? 'page' : undefined}>
              {item.index && <span class="nav-index">{item.index}</span>}
              <span>{item.name ?? item.title}</span>
            </a>
            {item.active && docHeadings.length > 0 && (
              <ul class="page-toc" aria-label={ui.onThisPage}>
                {docHeadings.map((heading) => (
                  <li><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </nav>
    </aside>

    <article class="markdown doc-article" data-doc-article>
      <header class="doc-header">
        <nav class="doc-breadcrumb small" aria-label="Breadcrumb">
          <a href={buildLangPath(lang, '/')}>{ui.home}</a>
          <span aria-hidden="true">/</span>
          <a href={collectionHome}>{taxonomy?.collectionLabel ?? collectionLabel}</a>
        </nav>
        <h1 class="doc-title">{title}</h1>
      </header>

      {docHeadings.length > 0 && (
        <details class="mobile-toc">
          <summary>{ui.onThisPage}</summary>
          <ul>
            {docHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ul>
        </details>
      )}

      <div class="doc-body">
        <slot />
      </div>

      <p class="doc-source small">
        <a href={sourceUrl} target="_blank" rel="noreferrer">{ui.sourceRepo} ↗</a>
        <span aria-hidden="true">·</span>
        <span>{ui.syncedAt} {syncedText}</span>
      </p>

      {(previousLink || nextLink) && (
        <nav class="doc-pagination">
          {previousLink ? (
            <a class="doc-page-link prev" href={previousLink.href}>
              <span class="small muted">← {ui.prev}</span>
              <strong>{previousLink.title}</strong>
            </a>
          ) : <div></div>}
          {nextLink ? (
            <a class="doc-page-link next" href={nextLink.href}>
              <span class="small muted">{ui.next} →</span>
              <strong>{nextLink.title}</strong>
            </a>
          ) : <div></div>}
        </nav>
      )}
    </article>
  </div>

  <button class="back-to-top" type="button" data-back-to-top>{ui.backToTop}</button>

  <script type="application/json" id="doc-ui-labels" set:html={JSON.stringify(ui)} />
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    z-index: 60;
    background: var(--brand);
  }
  .doc-header { margin-bottom: 2rem; }
  .doc-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.75rem;
    color: var(--muted);
  }
  .doc-breadcrumb a { color: var(--muted); text-decoration: none; }
  .doc-breadcrumb a:hover { color: var(--text); }
  .doc-title { font-size: clamp(1.75rem, 3vw, 2.3rem); line-height: 1.25; }
  .sidebar-home { display: block; text-decoration: none; }
  .sidebar-home:hover { color: var(--text); }
  .collection-nav { display: grid; gap: 1px; }
  .collection-nav-link {
    display: flex;
    gap: 0.6rem;
    padding: 0.4rem 0.6rem;
    border-radius: 7px;
    color: var(--muted);
    line-height: 1.5;
    font-size: 0.9rem;
  }
  .collection-nav-link:hover { color: var(--text); background: var(--surface-2); }
  .collection-nav-link.active { color: var(--brand); background: var(--brand-soft); font-weight: 500; }
  .nav-index {
    flex: 0 0 1.6rem;
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.85;
  }
  .collection-nav-link.active .nav-index { color: var(--brand); }
  .doc-source {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 3rem 0 0;
    color: var(--muted);
  }
  .doc-source a { color: var(--muted) !important; text-decoration: none !important; }
  .doc-source a:hover { color: var(--brand) !important; }
  .page-toc {
    list-style: none;
    margin: 0.25rem 0 0.6rem 1.15rem;
    padding: 0;
    border-left: 1px solid var(--line);
  }
  .page-toc a {
    display: block;
    margin-left: -1px;
    padding: 0.28rem 0 0.28rem 0.85rem;
    border-left: 1px solid transparent;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .page-toc a:hover { color: var(--text); }
  .page-toc a.is-active { color: var(--brand); border-left-color: var(--brand); }
  .doc-body > :global(h1:first-child) { display: none; }
  .doc-body :global(h2),
  .doc-body :global(h3),
  .doc-body :global(h4) { position: relative; }
  .doc-body :global(.heading-anchor) {
    opacity: 0;
    margin-left: 0.4rem;
    color: var(--muted);
    font-size: 0.85em;
    text-decoration: none;
    transition: 140ms ease;
  }
  .doc-body :global(h2:hover .heading-anchor),
  .doc-body :global(h3:hover .heading-anchor),
  .doc-body :global(h4:hover .heading-anchor),
  .doc-body :global(.heading-anchor:focus-visible) { opacity: 1; }
  .doc-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .doc-page-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none !important;
    transition: border-color 140ms ease;
  }
  .doc-page-link strong { font-weight: 550; line-height: 1.5; }
  .doc-page-link:hover { border-color: var(--brand); }
  .doc-page-link:hover strong { color: var(--brand); }
  .doc-page-link.next { text-align: right; }
  .doc-article :global(pre) { position: relative; }
  .doc-article :global(.code-language-badge) {
    position: absolute;
    top: 0.7rem;
    left: 1.1rem;
    color: #8b919c;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .doc-article :global(.copy-code-button) {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    border: 1px solid #2e323a;
    background: #1f2228;
    color: #b8bdc7;
    border-radius: 6px;
    padding: 0.25rem 0.55rem;
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
    transition: 140ms ease;
  }
  .doc-article :global(.copy-code-button:hover) { color: #fff; border-color: #444a55; }
  .doc-article :global(.copy-code-button[data-copied='true']) { color: #9be2bd; border-color: #2f5a45; }
  .back-to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition: 180ms ease;
    box-shadow: 0 4px 14px -6px rgba(0, 0, 0, 0.2);
  }
  .back-to-top:hover { color: var(--text); }
  .back-to-top.is-visible { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .mobile-toc { display: none; }
  @media (max-width: 960px) {
    .mobile-toc { display: block; margin: -0.5rem 0 1.5rem; }
    .mobile-toc ul { margin: 0; padding: 0.5rem 1rem 0.75rem 2.1rem; }
    .mobile-toc li { margin: 0.2rem 0; }
    .mobile-toc a { color: var(--text-soft); text-decoration: none; }
    .doc-pagination { grid-template-columns: 1fr; }
    .back-to-top { right: 1rem; bottom: 1rem; }
  }
</style>

<script>
  const labelsEl = document.getElementById('doc-ui-labels');
  const labels = labelsEl ? JSON.parse(labelsEl.textContent || '{}') : {};

  const setupCopyButtons = () => {
    document.querySelectorAll('article.doc-article pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;

      if (!pre.querySelector('.code-language-badge')) {
        const lang = (pre.getAttribute('data-language') || code.getAttribute('data-language') || '').trim();
        if (lang) {
          const badge = document.createElement('span');
          badge.className = 'code-language-badge';
          badge.textContent = lang;
          pre.appendChild(badge);
        }
      }

      if (pre.querySelector('.copy-code-button')) return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-button';
      button.textContent = labels.copy || 'Copy';
      button.addEventListener('click', async () => {
        const text = code.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = labels.copied || 'Copied';
          button.dataset.copied = 'true';
          window.setTimeout(() => {
            button.textContent = labels.copy || 'Copy';
            delete button.dataset.copied;
          }, 1600);
        } catch {
          button.textContent = labels.failed || 'Failed';
          window.setTimeout(() => {
            button.textContent = labels.copy || 'Copy';
          }, 1600);
        }
      });
      pre.appendChild(button);
    });
  };

  const setupHeadingAnchors = () => {
    document.querySelectorAll('.doc-body h2[id], .doc-body h3[id], .doc-body h4[id]').forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.textContent = '#';
      anchor.setAttribute('aria-label', labels.link || 'Copy heading link');
      anchor.addEventListener('click', async (event) => {
        event.preventDefault();
        const href = `${window.location.origin}${window.location.pathname}#${heading.id}`;
        history.replaceState(null, '', `#${heading.id}`);
        try {
          await navigator.clipboard.writeText(href);
        } catch {}
      });
      heading.appendChild(anchor);
    });
  };

  const setupReadingProgress = () => {
    const progress = document.querySelector('[data-reading-progress]');
    const article = document.querySelector('[data-doc-article]');
    const backToTop = document.querySelector('[data-back-to-top]');
    if (!(progress instanceof HTMLElement) || !(article instanceof HTMLElement)) return;

    const update = () => {
      const rect = article.getBoundingClientRect();
      const articleTop = window.scrollY + rect.top;
      const articleHeight = Math.max(article.offsetHeight - window.innerHeight, 1);
      const scrolled = Math.min(Math.max((window.scrollY - articleTop) / articleHeight, 0), 1);
      progress.style.width = `${scrolled * 100}%`;
      if (backToTop instanceof HTMLButtonElement) {
        backToTop.classList.toggle('is-visible', window.scrollY > articleTop + 320);
      }
    };

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    update();
  };

  const setupTocHighlight = () => {
    const links = new Map();
    document.querySelectorAll('[data-toc-link]').forEach((link) => links.set(link.getAttribute('data-toc-link'), link));
    if (links.size === 0) return;
    const headings = Array.from(document.querySelectorAll('.doc-body h2[id]')).filter((h) => links.has(h.id));
    const update = () => {
      let current = headings[0];
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top < 120) current = heading;
      }
      links.forEach((link, id) => link.classList.toggle('is-active', id === current?.id));
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  };

  const boot = () => {
    setupTocHighlight();
    setupCopyButtons();
    setupHeadingAnchors();
    setupReadingProgress();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
