---
interface Item {
  title: string;
  href: string;
  description?: string;
  meta?: string;
  detail?: string;
  searchText?: string;
  category?: string;
}
interface Props {
  items: Item[];
  variant?: 'default' | 'feature';
}
const { items, variant = 'default' } = Astro.props;
---
<div class:list={["grid", variant === 'feature' ? 'cols-3' : 'cols-2']}>
  {items.map((item) => (
    <a
      class:list={["card", "collection-card", variant === 'feature' && 'feature-card']}
      href={item.href}
      data-search={item.searchText ?? `${item.title} ${item.description ?? ''} ${item.meta ?? ''} ${item.detail ?? ''}`}
      data-category={item.category ?? 'all'}
    >
      {item.meta && !item.title.startsWith(item.meta) && <div class="badge">{item.meta}</div>}
      <h3>{item.title}</h3>
      {item.description && <p class="muted collection-desc">{item.description}</p>}
      {item.detail && <div class="collection-detail small">{item.detail}</div>}
      <span class="collection-arrow" aria-hidden="true">→</span>
    </a>
  ))}
</div>

<style>
  .collection-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text);
  }
  .collection-card h3 {
    font-size: 1.05rem;
    line-height: 1.45;
    margin: 0;
    padding-right: 1.5rem;
  }
  .collection-card:hover h3 { color: var(--brand); }
  .collection-desc {
    margin: 0;
    font-size: 0.93rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .collection-detail {
    margin-top: auto;
    color: var(--text-soft);
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .collection-arrow {
    position: absolute;
    top: 1.2rem;
    right: 1.2rem;
    color: var(--line-strong);
    transition: transform 140ms ease, color 140ms ease;
  }
  .collection-card:hover .collection-arrow {
    transform: translateX(3px);
    color: var(--brand);
  }
</style>
