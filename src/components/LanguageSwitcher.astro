---
import { LANG_CONFIG, type SiteLang } from '../lib/i18n';

interface LinkItem {
  lang: SiteLang;
  label: string;
  href: string;
}

interface Props {
  currentLang: SiteLang;
  links: LinkItem[];
}

const { currentLang, links } = Astro.props;
---
<div class="lang-switcher" aria-label="Language switcher">
  {links.map((item) => (
    <a class:list={["lang-link", item.lang === currentLang && 'active']} href={item.href} hreflang={item.lang} title={item.label}>
      {LANG_CONFIG[item.lang].navLabel}
    </a>
  ))}
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 2px;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--line);
  }
  .lang-link {
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 500;
    transition: color 140ms ease, background 140ms ease;
  }
  .lang-link:hover { color: var(--text); }
  .lang-link.active {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
</style>
